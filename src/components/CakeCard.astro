---
const { title, desc, emoji = '🍰', tag } = Astro.props;
---
<article class="card">
  <div class="thumb">
    <span class="emoji">{emoji}</span>
    {tag && <span class="tag">{tag}</span>}
  </div>
  <div class="body">
    <h3>{title}</h3>
    <p>{desc}</p>
    <span class="rule"></span>
  </div>
</article>

<style>
  .card {
    background: var(--white);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--line);
    transition: transform .5s var(--ease), box-shadow .5s var(--ease);
  }
  .card:hover { transform: translateY(-8px); box-shadow: var(--shadow); }
  .thumb {
    position: relative;
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    background:
      radial-gradient(120% 120% at 70% 20%, var(--blush-soft), transparent 60%),
      linear-gradient(135deg, var(--ivory-2), var(--blush));
  }
  .emoji { font-size: 3.6rem; transition: transform .5s var(--ease); filter: drop-shadow(0 8px 12px rgba(43,33,29,.14)); }
  .card:hover .emoji { transform: scale(1.08) rotate(-3deg); }
  .tag {
    position: absolute;
    top: .9rem; left: .9rem;
    background: rgba(255,255,255,.92);
    color: var(--gold-deep);
    font-size: .64rem;
    font-weight: 500;
    letter-spacing: .16em;
    text-transform: uppercase;
    padding: .35rem .75rem;
    border-radius: 999px;
    border: 1px solid var(--line);
  }
  .body { padding: 1.4rem 1.5rem 1.6rem; }
  .body h3 { font-size: 1.4rem; }
  .body p { margin: 0 0 1rem; font-size: .95rem; }
  .rule { display: block; width: 36px; height: 2px; background: var(--gold-grad); border-radius: 2px; }
</style>
