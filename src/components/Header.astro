---
const { pathname } = Astro.url;
const links = [
  { href: '/', label: 'Home' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const isActive = (href) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/">
      <span class="brand-name">Laurens<span class="amp"> </span>Cakes</span>
      <span class="brand-sub">Bespoke Bakery</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-burger" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="nav">
      {links.map((l) => (
        <a href={l.href} class={isActive(l.href) ? 'active' : ''}>{l.label}</a>
      ))}
      <a class="ig" href="https://www.instagram.com/laurenscakess/" target="_blank" rel="noopener">Order Now</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(250, 246, 241, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.05rem;
    padding-bottom: 1.05rem;
  }
  .brand { display: flex; flex-direction: column; line-height: 1; }
  .brand:hover { color: inherit; }
  .brand-name {
    font-family: var(--font-head);
    font-weight: 500;
    font-size: 1.65rem;
    color: var(--espresso);
    letter-spacing: .01em;
  }
  .brand-sub {
    font-size: .62rem;
    letter-spacing: .4em;
    text-transform: uppercase;
    color: var(--gold-deep);
    margin-top: .35rem;
    font-weight: 400;
  }

  .nav { display: flex; align-items: center; gap: 2.1rem; }
  .nav a {
    color: var(--cocoa);
    font-weight: 400;
    font-size: .8rem;
    letter-spacing: .16em;
    text-transform: uppercase;
    position: relative;
    padding: .25rem 0;
  }
  .nav a:not(.ig)::after {
    content: "";
    position: absolute;
    left: 0; bottom: -2px;
    width: 0; height: 1px;
    background: var(--gold-grad);
    transition: width .3s var(--ease);
  }
  .nav a:not(.ig):hover::after,
  .nav a.active:not(.ig)::after { width: 100%; }
  .nav a:hover { color: var(--espresso); }
  .nav a.active { color: var(--espresso); }

  .nav a.ig {
    background: var(--espresso);
    color: var(--ivory);
    padding: .7rem 1.35rem;
    border-radius: 999px;
    font-size: .72rem;
    transition: background .3s var(--ease), transform .3s var(--ease);
  }
  .nav a.ig:hover { background: var(--gold-deep); color: #fff; transform: translateY(-2px); }
  .nav a.ig::after { display: none; }

  .nav-toggle, .nav-burger { display: none; }

  @media (max-width: 820px) {
    .nav-burger {
      display: flex;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      padding: 6px;
    }
    .nav-burger span {
      width: 26px; height: 2px;
      background: var(--espresso);
      border-radius: 2px;
      transition: .2s;
    }
    .nav {
      position: absolute;
      top: 100%;
      left: 0; right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      background: var(--ivory);
      border-bottom: 1px solid var(--line);
      padding: .5rem 1.5rem 1.25rem;
      display: none;
    }
    .nav a { padding: .85rem 0; width: 100%; }
    .nav a.ig { text-align: center; margin-top: .5rem; }
    .nav-toggle:checked ~ .nav { display: flex; }
  }
</style>
