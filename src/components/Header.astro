---
const { pathname } = Astro.url;
const links = [
  { href: '/', label: 'Home' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const isActive = (href) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/">
      <span class="brand-mark">🎂</span>
      <span class="brand-name">Laurens Cakes</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-burger" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="nav">
      {links.map((l) => (
        <a href={l.href} class={isActive(l.href) ? 'active' : ''}>{l.label}</a>
      ))}
      <a class="ig" href="https://www.instagram.com/laurenscakess/" target="_blank" rel="noopener">Instagram</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 248, 243, 0.9);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--cream-2);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: .85rem;
    padding-bottom: .85rem;
  }
  .brand { display: flex; align-items: center; gap: .55rem; }
  .brand:hover { text-decoration: none; }
  .brand-mark { font-size: 1.5rem; }
  .brand-name {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--cocoa);
  }
  .nav { display: flex; align-items: center; gap: 1.4rem; }
  .nav a { color: var(--cocoa); font-weight: 500; }
  .nav a:hover { color: var(--pink-deep); text-decoration: none; }
  .nav a.active { color: var(--pink-deep); }
  .nav a.ig {
    background: var(--pink);
    color: #fff;
    padding: .45rem 1rem;
    border-radius: 999px;
  }
  .nav a.ig:hover { background: var(--pink-deep); }

  .nav-toggle, .nav-burger { display: none; }

  @media (max-width: 760px) {
    .nav-burger {
      display: flex;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      padding: 6px;
    }
    .nav-burger span {
      width: 26px; height: 3px;
      background: var(--cocoa);
      border-radius: 2px;
      transition: .2s;
    }
    .nav {
      position: absolute;
      top: 100%;
      left: 0; right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      background: var(--cream);
      border-bottom: 1px solid var(--cream-2);
      padding: .5rem 1.25rem 1rem;
      display: none;
    }
    .nav a { padding: .6rem 0; width: 100%; }
    .nav-toggle:checked ~ .nav { display: flex; }
  }
</style>
