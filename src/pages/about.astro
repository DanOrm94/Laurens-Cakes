---
import Base from '../layouts/Base.astro';
---
<Base title="About — Laurens Cakes" description="Meet the baker behind Laurens Cakes.">
  <section class="section">
    <div class="container about">
      <div class="art reveal" aria-hidden="true">
        <div class="art-ring"></div>
        <span>👩‍🍳</span>
      </div>
      <div class="text reveal">
        <p class="eyebrow">The Baker</p>
        <h1>Hello, I'm Lauren</h1>
        <p>Laurens Cakes began with a simple love of baking and a belief that every
          celebration deserves a cake made with real care. Each one is handmade to order,
          using the finest ingredients and a lot of attention to detail.</p>
        <p>Whether it's a first birthday, a wedding, or simply a reason to treat someone,
          I work closely with you to design a cake that suits your taste, theme and
          occasion perfectly.</p>
        <p>Laurens Cakes is a fully insured and registered home bakery, baking fresh for
          every order — and I ship anywhere in the UK, so your cake can reach you wherever
          you are.</p>
        <a class="btn gold" href="/contact">Let's Plan Your Cake</a>
      </div>
    </div>
  </section>

  <section class="values">
    <div class="container">
      <div class="center reveal">
        <p class="eyebrow">Promises</p>
        <hr class="divider" />
        <h2>What every order gets</h2>
      </div>
      <div class="v-grid reveal">
        <div class="v"><span>🥣</span><h3>Handmade</h3><p>Every cake is baked and decorated by hand, to order.</p></div>
        <div class="v"><span>🌿</span><h3>Finest ingredients</h3><p>Great cake starts with great ingredients — always.</p></div>
        <div class="v"><span>🎨</span><h3>Fully bespoke</h3><p>Your theme, your flavours, your design.</p></div>
        <div class="v"><span>📦</span><h3>Shipped with care</h3><p>Carefully packaged and delivered across the UK.</p></div>
      </div>
    </div>
  </section>
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: .85fr 1.15fr;
    gap: 3rem;
    align-items: center;
  }
  .art {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--radius);
    background: radial-gradient(circle at 32% 30%, #fff, var(--blush));
    display: grid;
    place-items: center;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .art-ring {
    position: absolute;
    inset: 16px;
    border: 1px solid var(--gold);
    opacity: .55;
    border-radius: calc(var(--radius) - 6px);
  }
  .art span { font-size: clamp(5rem, 12vw, 8rem); }

  .values { background: var(--ivory-2); padding: clamp(3rem,7vw,5rem) 0; }
  .v-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px,1fr)); gap: 1.75rem; margin-top: 3rem; }
  .v {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 2rem 1.5rem;
    text-align: center;
    box-shadow: var(--shadow-sm);
    transition: transform .5s var(--ease), box-shadow .5s var(--ease);
  }
  .v:hover { transform: translateY(-6px); box-shadow: var(--shadow); }
  .v span { font-size: 2.4rem; }
  .v h3 { font-size: 1.3rem; margin-top: .5rem; }
  .v p { margin: 0; font-size: .92rem; }

  @media (max-width: 820px) {
    .about { grid-template-columns: 1fr; text-align: center; }
    .art { max-width: 300px; margin: 0 auto; }
    .text .eyebrow { justify-content: center; }
  }
</style>
