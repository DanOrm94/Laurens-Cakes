---
import Base from '../layouts/Base.astro';
---
<Base title="About — Laurens Cakes" description="Meet the baker behind Laurens Cakes.">
  <section class="section">
    <div class="container about">
      <div class="art" aria-hidden="true"><span>👩‍🍳</span></div>
      <div class="text">
        <p class="eyebrow">Hello, I'm Lauren</p>
        <h1>The baker behind the cakes</h1>
        <p>Laurens Cakes started with a simple love of baking and a belief that every
          celebration deserves a cake made with real care. Each one is handmade to order,
          using quality ingredients and a lot of attention to detail.</p>
        <p>Whether it's a first birthday, a wedding, or just a reason to treat someone,
          I work with you to design a cake that fits your taste, theme and occasion
          perfectly.</p>
        <p>Based locally and baking fresh for every order — no two cakes are ever the same.</p>
        <a class="btn" href="/contact">Let's plan your cake</a>
      </div>
    </div>
  </section>

  <section class="values">
    <div class="container v-grid">
      <div class="v"><span>🥣</span><h3>Handmade</h3><p>Every cake is baked and decorated by hand, to order.</p></div>
      <div class="v"><span>🌿</span><h3>Quality ingredients</h3><p>Good cake starts with good ingredients — always.</p></div>
      <div class="v"><span>🎨</span><h3>Fully custom</h3><p>Your theme, your flavours, your design.</p></div>
    </div>
  </section>
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: .8fr 1.2fr;
    gap: 2.5rem;
    align-items: center;
  }
  .art {
    aspect-ratio: 1;
    border-radius: var(--radius);
    background: radial-gradient(circle at 30% 30%, #fbd3e4, var(--pink));
    display: grid;
    place-items: center;
    box-shadow: var(--shadow);
  }
  .art span { font-size: clamp(5rem, 12vw, 8rem); }

  .values { background: var(--cream-2); padding: clamp(2.5rem,6vw,4rem) 0; }
  .v-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px,1fr)); gap: 1.5rem; }
  .v {
    background: var(--white);
    border-radius: var(--radius);
    padding: 1.6rem;
    text-align: center;
    box-shadow: var(--shadow);
  }
  .v span { font-size: 2.4rem; }
  .v p { margin: 0; font-size: .95rem; }

  @media (max-width: 760px) {
    .about { grid-template-columns: 1fr; text-align: center; }
    .art { max-width: 260px; margin: 0 auto; }
  }
</style>
