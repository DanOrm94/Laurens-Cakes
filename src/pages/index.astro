---
import Base from '../layouts/Base.astro';
import CakeCard from '../components/CakeCard.astro';

const specialties = [
  { title: 'Celebration Cakes', emoji: '🎂', tag: 'Popular', desc: 'Show-stopping centrepieces for birthdays and milestones, made to your theme.' },
  { title: 'Wedding Cakes', emoji: '💐', tag: 'Bespoke', desc: 'Elegant tiered designs tailored to your big day, tasting included.' },
  { title: 'Cupcakes & Treats', emoji: '🧁', desc: 'Batches of soft, beautifully piped cupcakes perfect for parties.' },
  { title: 'Custom Designs', emoji: '🍰', tag: 'Made to order', desc: 'Have an idea? Bring it to life with a one-of-a-kind custom bake.' },
];
---
<Base title="Laurens Cakes — Handmade Celebration Cakes">
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Baked fresh to order</p>
        <h1>Cakes made with love for life's sweetest moments</h1>
        <p class="lead">From birthdays to weddings, Laurens Cakes creates handmade,
          custom cakes that taste as wonderful as they look.</p>
        <div class="cta">
          <a class="btn" href="/contact">Order a Cake</a>
          <a class="btn ghost" href="/gallery">View Gallery</a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="blob"></div>
        <span class="cake">🎂</span>
      </div>
    </div>
  </section>

  <!-- Specialties -->
  <section class="section">
    <div class="container">
      <div class="center">
        <p class="eyebrow">What I make</p>
        <h2>Something sweet for every occasion</h2>
      </div>
      <div class="grid">
        {specialties.map((s) => <CakeCard {...s} />)}
      </div>
    </div>
  </section>

  <!-- Instagram band -->
  <section class="ig-band">
    <div class="container ig-inner">
      <div>
        <p class="eyebrow light">Follow along</p>
        <h2 class="light">See the latest bakes on Instagram</h2>
        <p class="light-p">New cakes, behind-the-scenes and daily sweetness over on
          <strong>@laurenscakess</strong>.</p>
      </div>
      <a class="btn ig-btn" href="https://www.instagram.com/laurenscakess/" target="_blank" rel="noopener">
        Follow @laurenscakess
      </a>
    </div>
  </section>
</Base>

<style>
  .hero {
    background: linear-gradient(160deg, var(--cream) 0%, var(--cream-2) 100%);
    overflow: hidden;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    gap: 2rem;
    align-items: center;
    padding: clamp(3rem, 7vw, 5.5rem) 1.25rem;
  }
  .cta { display: flex; gap: .9rem; flex-wrap: wrap; margin-top: 1.4rem; }
  .lead { margin-inline: 0; }

  .hero-art { position: relative; display: grid; place-items: center; min-height: 320px; }
  .blob {
    width: min(360px, 80%);
    aspect-ratio: 1;
    background: radial-gradient(circle at 30% 30%, #fbd3e4, var(--pink));
    border-radius: 48% 52% 55% 45% / 55% 45% 55% 45%;
    animation: morph 9s ease-in-out infinite;
    box-shadow: var(--shadow);
  }
  .cake { position: absolute; font-size: clamp(6rem, 16vw, 10rem); filter: drop-shadow(0 12px 18px rgba(74,54,48,.25)); }
  @keyframes morph {
    0%,100% { border-radius: 48% 52% 55% 45% / 55% 45% 55% 45%; }
    50% { border-radius: 55% 45% 45% 55% / 45% 55% 45% 55%; }
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .ig-band { background: linear-gradient(135deg, var(--pink), var(--pink-deep)); }
  .ig-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding: clamp(2.5rem, 6vw, 4rem) 1.25rem;
  }
  .light { color: #fff; }
  .light-p { color: #ffeaf3; margin: 0; }
  .eyebrow.light { color: #ffe6b8; }
  .ig-btn { background: #fff; color: var(--pink-deep); }
  .ig-btn:hover { background: #fff; color: #bc5888; }

  @media (max-width: 760px) {
    .hero-inner { grid-template-columns: 1fr; text-align: center; }
    .cta { justify-content: center; }
    .lead { margin-inline: auto; }
    .hero-art { order: -1; min-height: 220px; }
  }
</style>
